[Unit]
Description=llama.cpp server with cuBLAS (CUDA) multi‑GPU
After=network-online.target nvidia-persistenced.service
Wants=network-online.target nvidia-persistenced.service

[Service]
User=root
ExecStart=/opt/llama/run_server.sh
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
